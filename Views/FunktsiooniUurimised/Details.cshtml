@using FunktsiooniUurimine.Models
@model global::FunktsiooniUurimine.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Funktsiooni detailid";
}

<div class="details-container">

    <div class="page-header">

        <div>

            <div class="small-label">
                FUNKTSIOON
            </div>

            <h1>Funktsiooni uurimine</h1>

            <p class="function-formula math-display">
                f(x) = @Html.Raw(MathDisplayFormatter.Format(Model.Valem))
            </p>

        </div>

        <div class="header-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn-primary-custom">
                Muuda
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn-danger-custom">
                Kustuta
            </a>

        </div>

    </div>


    <div class="results-grid">

        <div class="result-card">

            <div class="result-icon">
                D
            </div>

            <div>

                <div class="result-title">
                    Määramispiirkond
                </div>

                <div class="result-value">
                    @Model.Maaramispiirkond
                </div>

            </div>

        </div>


        <div class="result-card">

            <div class="result-icon">
                x
            </div>

            <div>

                <div class="result-title">
                    Nullkohad
                </div>

                <div class="result-value math-display">
                    @Html.Raw(MathDisplayFormatter.Format(Model.Nullkohad))
                </div>

            </div>

        </div>


        <div class="result-card">

            <div class="result-icon">
                f′
            </div>

            <div>

                <div class="result-title">
                    Tuletis
                </div>

                <div class="result-value math-display">
                    f′(x) = @Html.Raw(MathDisplayFormatter.Format(Model.Tuletis))
                </div>

            </div>

        </div>


        <div class="result-card">

            <div class="result-icon">
                ±
            </div>

            <div>

                <div class="result-title">
                    Kriitilised punktid
                </div>

                <div class="result-value">
                    @Model.KriitilisedPunktid
                </div>

            </div>

        </div>


        <div class="result-card result-card-wide">

            <div class="result-icon">
                ↕
            </div>

            <div>

                <div class="result-title">
                    Ekstreemumid
                </div>

                <div class="result-value">
                    @Model.Ekstreemumid
                </div>

            </div>

        </div>

    </div>


    <section class="solution-card">
        <p class="small-label">LAHENDUS</p>
        <h2>Funktsiooni uurimine sammhaaval</h2>
        <ol class="solution-steps">
            <li>
                <strong>Määramispiirkond:</strong>
                kontrollime, kus valem on arvutatav. Tulemus: @Model.Maaramispiirkond.
            </li>
            <li>
                <strong>Nullkohad:</strong>
                lahendame võrrandi <code>f(x) = 0</code>. Tulemus: @Html.Raw(MathDisplayFormatter.Format(Model.Nullkohad)).
                <span>Nullkohti otsitakse ligikaudselt vahemikus [-10; 10].</span>
            </li>
            <li>
                <strong>Tuletis:</strong>
                tuletame valemi <code>f(x) = @Html.Raw(MathDisplayFormatter.Format(Model.Valem))</code> ja saame
                <code>f′(x) = @Html.Raw(MathDisplayFormatter.Format(Model.Tuletis))</code>.
            </li>
            <li>
                <strong>Kriitilised punktid:</strong>
                lahendame <code>f'(x) = 0</code>. Tulemus: @Model.KriitilisedPunktid.
            </li>
            <li>
                <strong>Ekstreemumid:</strong>
                kontrollime tuletise märgi muutumist. Tulemus: @Model.Ekstreemumid.
            </li>
        </ol>
    </section>


    <div class="graph-card">

        <div class="graph-header">

            <div class="small-label">
                GRAAFIK
            </div>

            <h2>
                Funktsiooni graafik
            </h2>

            <p>
                Graafikul on näidatud <strong>f(x)</strong> vahemikus [-5; 5].
            </p>

        </div>


        <div class="graph-container">

            <canvas id="funktsiooniGraafik"></canvas>

        </div>

    </div>


    <div class="bottom-actions">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-primary-custom">
            Muuda funktsiooni
        </a>

        <a asp-action="Index"
           class="btn-secondary-custom">
            Tagasi nimekirja
        </a>

    </div>

</div>


@section Scripts {

    <script>

        const xVaartused =
            @Html.Raw(ViewBag.XVaartused);

        const funktsiooniPunktid =
            @Html.Raw(ViewBag.FunktsiooniPunktid);

        const ctx =
            document.getElementById('funktsiooniGraafik');

        const graafikuVaartused =
            funktsiooniPunktid.filter(value => value !== null && Number.isFinite(value));

        const minY = Math.min(...graafikuVaartused);
        const maxY = Math.max(...graafikuVaartused);
        const yPadding = ((maxY - minY) || 1) * 0.2;

        if (ctx && typeof Chart !== 'undefined') {

            new Chart(ctx, {

                type: 'line',

                data: {

                    labels: xVaartused,

                    datasets: [{
                        label: 'f(x)',
                        borderColor: '#327d79',
                        data: funktsiooniPunktid,
                        borderWidth: 2.5,
                        pointRadius: 0,
                        tension: 0.1,
                        spanGaps: false
                    }]

                },


                options: {

                    responsive: true,
                    maintainAspectRatio: false,

                    interaction: {

                        mode: 'index',

                        intersect: false

                    },


                    plugins: {

                        legend: {

                            display: true,

                            position: 'top',
                            labels: {
                                usePointStyle: true,
                                pointStyle: 'line',
                                boxWidth: 10,
                                color: '#22313f'
                            }

                        },

                        tooltip: {

                            enabled: true,
                            backgroundColor: '#1d3557',
                            titleColor: '#ffffff',
                            bodyColor: '#ffffff',
                            borderColor: '#ff8a5b',
                            borderWidth: 1

                        }

                    },


                    scales: {

                        x: {
                            min: -5,
                            max: 5,
                            grid: {
                                color: 'rgba(29, 53, 87, 0.08)'
                            },
                            title: {

                                display: true,

                                text: 'x',
                                color: '#22313f',
                                font: {
                                    weight: '700'
                                }

                            },

                            ticks: {
                                maxTicksLimit: 11,
                                color: '#5f6f7d'
                            }

                        },


                        y: {
                            min: minY - yPadding,
                            max: maxY + yPadding,
                            grid: {
                                color: 'rgba(29, 53, 87, 0.08)'
                            },
                            title: {

                                display: true,

                                text: 'y',
                                color: '#22313f',
                                font: {
                                    weight: '700'
                                }

                            },
                            ticks: {
                                color: '#5f6f7d'
                            }

                        }

                    }

                }

            });

        }

    </script>

}


<style>

    .details-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px 60px;
    }


    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 25px;
        margin-bottom: 30px;
        background: linear-gradient(135deg, #f8fafb 0%, #eef5f4 100%);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 24px 26px;
        box-shadow: 0 10px 22px rgba(41, 53, 65, 0.06);
    }


    .small-label {
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.2px;
        margin-bottom: 7px;
    }


    .page-header h1 {
        margin: 0;
        font-size: 34px;
        font-weight: 700;
    }


    .function-formula {
        margin: 12px 0 0;
        color: var(--ink);
        font-size: 1.2rem;
        font-weight: 700;
        display: inline-block;
        background: rgba(198, 91, 61, 0.08);
        border: 1px solid rgba(198, 91, 61, 0.12);
        border-radius: 12px;
        padding: 12px 16px;
    }


    .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }


    .btn-primary-custom,
    .btn-secondary-custom,
    .btn-danger-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        padding: 10px 17px;
        border-radius: 6px;
        font-weight: 600;
        transition: 0.2s;
        border: none;
    }


    .btn-primary-custom {
        background: var(--accent);
        color: white;
    }


        .btn-primary-custom:hover {
            background: var(--accent-hover);
            color: white;
        }


    .btn-secondary-custom {
        background: var(--nav);
        color: white;
    }


        .btn-secondary-custom:hover {
            background: #3c4a58;
            color: white;
        }


    .btn-danger-custom {
        background: var(--danger);
        color: white;
    }


        .btn-danger-custom:hover {
            background: #96313c;
            color: white;
        }


    .results-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }


    .result-card {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafb 100%);
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 12px;
        padding: 18px 20px;
        box-shadow: 0 8px 16px rgba(41, 53, 65, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .result-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px rgba(41, 53, 65, 0.08);
    }


    .result-card-wide {
        grid-column: 1 / -1;
    }


    .result-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 12px;
        background: var(--accent-soft);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
    }


    .result-title {
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 5px;
    }


    .result-value {
        font-size: 16px;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.5;
        word-break: break-word;
    }


    .graph-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8fafb 100%);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 10px 22px rgba(41, 53, 65, 0.05);
    }


    .solution-card {
        margin: 25px 0;
        padding: 24px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafb 100%);
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: 0 8px 18px rgba(41, 53, 65, 0.04);
    }


    .solution-card h2 {
        margin: 0 0 15px;
        font-size: 24px;
    }


    .solution-steps {
        margin: 0;
        padding-left: 22px;
    }


    .solution-steps li {
        padding: 10px 0;
        border-bottom: 1px solid var(--line);
        line-height: 1.6;
    }


    .solution-steps li:last-child {
        border-bottom: 0;
    }


    .solution-steps span {
        display: block;
        color: var(--muted);
        font-size: 14px;
    }


    .graph-header {
        margin-bottom: 20px;
    }


        .graph-header h2 {
            margin: 0;
            font-size: 25px;
            font-weight: 700;
        }


        .graph-header p {
            margin: 7px 0 0;
            color: var(--muted);
            font-size: 14px;
        }


    .graph-container {
        width: 100%;
        margin-top: 20px;
    }


        .graph-container canvas {
            width: 100% !important;
        }


    .bottom-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
        flex-wrap: wrap;
    }


    @@media (max-width: 800px) {

        .page-header {
            flex-direction: column;
        }


        .results-grid {
            grid-template-columns: 1fr;
        }


        .result-card-wide {
            grid-column: auto;
        }
    }


    @@media (max-width: 600px) {

        .details-container {
            padding: 25px 15px 40px;
        }


        .page-header h1 {
            font-size: 28px;
        }


        .graph-card {
            padding: 15px;
        }


        .solution-card {
            padding: 16px;
        }
    }

</style>