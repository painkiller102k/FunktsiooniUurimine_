@model global::FunktsiooniUurimine.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Uus funktsioon";
}

<section class="formula-page">
    <h1>Lisa funktsioon</h1>
    <p>Sisesta valem ja rakendus arvutab selle omadused.</p>

    <div class="formula-panel">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_FormulaEditor" model="Model" />

            <div class="formula-actions">
                <button class="btn btn-primary" type="submit">Uuri funktsiooni</button>
                <a class="btn btn-light" asp-action="Index">Tagasi</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}