@model global::FunktsiooniUurimine.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Kustuta funktsioon";
}

<div class="page-container">

    <div class="page-header">

        <div>

            <div class="small-label">
                FUNKTSIOONI KUSTUTAMINE
            </div>

            <h1>
                Kustuta funktsioon
            </h1>

            <p>
                See tegevus eemaldab funktsiooni ja selle salvestatud tulemused.
            </p>

        </div>

    </div>


    <div class="delete-card">

        <div class="warning-icon">
            !
        </div>


        <h2>
            Kas oled kindel?
        </h2>


        <p class="warning-text">
            Funktsiooni kustutamisel eemaldatakse ka kõik selle
            arvutatud matemaatilised tulemused.
        </p>


        <div class="function-preview">

            <div class="preview-label">
                Funktsioon
            </div>

            <div class="preview-value">
                f(x) = @Model.Valem
            </div>

        </div>


        <div class="results-preview">

            <div>
                <span>Määramispiirkond</span>
                <strong>@Model.Maaramispiirkond</strong>
            </div>

            <div>
                <span>Nullkohad</span>
                <strong>@Model.Nullkohad</strong>
            </div>

            <div>
                <span>Tuletis</span>
                <strong>@Model.Tuletis</strong>
            </div>

            <div>
                <span>Ekstreemumid</span>
                <strong>@Model.Ekstreemumid</strong>
            </div>

        </div>


        <form asp-action="Delete"
              method="post"
              class="delete-actions">

            <input type="hidden"
                   asp-for="Id" />

            <button type="submit"
                    class="btn-danger-custom">
                Kustuta funktsioon
            </button>

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn-secondary-custom">
                Tühista
            </a>

        </form>

    </div>

</div>


<style>

    .page-container {
        max-width: 850px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .small-label {
        color: #dc3545;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 34px;
        font-weight: 700;
    }

    .page-header p {
        color: #6c757d;
        margin-top: 8px;
    }

    .delete-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 15px;
        padding: 35px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    }

    .warning-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #f8d7da;
        color: #842029;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        font-weight: 700;
    }

    .delete-card h2 {
        margin-bottom: 10px;
    }

    .warning-text {
        color: #6c757d;
        max-width: 600px;
        margin: 0 auto 25px;
    }

    .function-preview {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 18px;
        text-align: left;
    }

    .preview-label {
        color: #6c757d;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .preview-value {
        font-family: monospace;
        font-size: 20px;
        font-weight: 600;
    }

    .results-preview {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: #dee2e6;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        overflow: hidden;
        text-align: left;
        margin-bottom: 25px;
    }

        .results-preview div {
            background: white;
            padding: 14px;
        }

        .results-preview span {
            display: block;
            color: #6c757d;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .results-preview strong {
            display: block;
            font-size: 14px;
            word-break: break-word;
        }

    .delete-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-danger-custom,
    .btn-secondary-custom {
        border: none;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 9px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-danger-custom {
        background: #dc3545;
        color: white;
    }

        .btn-danger-custom:hover {
            background: #bb2d3b;
        }

    .btn-secondary-custom {
        background: #6c757d;
        color: white;
        display: inline-flex;
        align-items: center;
    }

        .btn-secondary-custom:hover {
            background: #5c636a;
            color: white;
        }

</style>